# CBdesign · configuración para LiteSpeed / Apache

ErrorDocument 404 /404.html
Options -Indexes
AddDefaultCharset UTF-8

# Reglas de reescritura (sin IfModule para que OpenLiteSpeed también las lea)
RewriteEngine On
# Una sola versión del sitio: https y sin www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://cbdesign.com.co%{REQUEST_URI} [R=301,L]
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/en/index\.html[\s?] [NC]
RewriteRule ^en/index\.html$ /en/ [R=301,L]
# Inglés por defecto: quien entra al inicio con el navegador en inglés va a /en/.
# Solo aplica al inicio, respeta la elección guardada (cookie cb_idioma o ?lang=)
# y no afecta a Google, que rastrea sin idioma preferido y ve cada versión en su URL.
RewriteCond %{HTTP:Accept-Language} ^en [NC]
RewriteCond %{HTTP_COOKIE} !cb_idioma= [NC]
RewriteCond %{QUERY_STRING} !(^|&)(lang|dominio)= [NC]
RewriteRule ^$ /en/ [R=302,L]

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
